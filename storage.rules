rules_version = '2';

// ============================================================
//  REGLAS DE FIREBASE STORAGE
// ============================================================
//  Imágenes y audios: los lee quien ha entrado en la app; los sube
//  el importador con credenciales de administrador (que no pasan por
//  estas reglas). Desde el navegador no se puede escribir nada.
// ============================================================

service firebase.storage {
  match /b/{bucket}/o {

    match /images/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /audio/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
