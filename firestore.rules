rules_version = '2';

// ============================================================
//  REGLAS DE FIRESTORE
// ============================================================
//  Dos ideas, nada más:
//
//   1. El contenido (cards, themes) es de SOLO LECTURA para la app,
//      y solo para quien ha entrado con su cuenta. Escribirlo es cosa
//      del importador de tools/import/, que usa el Admin SDK y por
//      tanto NO pasa por estas reglas.
//
//   2. El progreso es privado: cada persona solo llega al suyo.
//
//  Nada de "allow read, write: if true".
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function haEntrado() {
      return request.auth != null;
    }

    // ---------- contenido ----------

    match /cards/{cardId} {
      // Solo tarjetas activas, y solo lectura.
      allow get, list: if haEntrado() && resource.data.active == true;
      allow create, update, delete: if false;
    }

    match /themes/{themeId} {
      allow get, list: if haEntrado();
      allow create, update, delete: if false;
    }

    // ---------- progreso ----------

    match /users/{uid} {
      // El documento del usuario en sí no se usa todavía; que no se pueda
      // escribir nada suelto ahí.
      allow read: if haEntrado() && request.auth.uid == uid;
      allow write: if false;

      match /progress/{cardId} {
        allow read, write: if haEntrado() && request.auth.uid == uid;
      }
    }

    // ---------- todo lo demás ----------

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
