# ============================================================
#  Variables de entorno del proyecto
# ============================================================
#  Copia este fichero como .env y rellénalo. .env está en .gitignore.
#
#      cp .env.example .env
#
#  Con la primera sección se genera la configuración web:
#
#      node tools/generar-config.mjs   →  vocabulario/js/firebase-config.js
# ============================================================

# --- App web (Consola de Firebase → Configuración del proyecto → App web) ---
# Estos valores NO son secretos: viajan en cualquier app web de Firebase.
# Lo que protege los datos son firestore.rules y storage.rules.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
FIREBASE_PROJECT_ID=tu-proyecto
FIREBASE_STORAGE_BUCKET=tu-proyecto.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# --- Importador (tools/import) — ESTO SÍ ES SECRETO ---
# Ruta al JSON de la cuenta de servicio (Consola → Configuración del proyecto
# → Cuentas de servicio → Generar nueva clave privada).
# Guárdalo FUERA del repositorio.
GOOGLE_APPLICATION_CREDENTIALS=/ruta/absoluta/a/clave-cuenta-de-servicio.json
